{
  "name": "raseed-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:win": "electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.0.8",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "@capacitor/core": "^5.6.0",
    "@capacitor/cli": "^5.6.0",
    "@capacitor/android": "^5.6.0"
  },
  "build": {
    "appId": "com.raseed.system",
    "productName": "Raseed",
    "files": [
      "dist/**/*",
      "electron-main.js"
    ],
    "directories": {
      "output": "dist-installers"
    },
    "win": {
      "target": "portable"
    }
  }
}