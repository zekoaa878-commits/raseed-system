{
  "name": "raseed-v4",
  "version": "4.0.0",
  "main": "electron-main.js",
  "scripts": {
    "build:win": "electron-builder --win portable --x64 --publish=never"
  },
  "build": {
    "appId": "com.raseed.system",
    "productName": "Raseed V4",
    "files": [
      "index.html",
      "electron-main.js"
    ],
    "directories": {
      "output": "dist-installers"
    },
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}